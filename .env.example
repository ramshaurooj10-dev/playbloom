# Playroom — environment variables (Play-Store-only app)
#
# SUPABASE IS GONE (removed 2026-11-07 with the license system).
# Do not re-add VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY — nothing in the app reads them any more.
# Remember to delete the Supabase tables in the Supabase dashboard:
# school_licenses, schools, school_requests, school_renewal_requests,
# payments, user_licenses, payment_issues, notifications, purchases,
# feedback, products, profiles.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Google Play purchase verification (server-side, optional)
# ---------------------------------------------------------------------------
# PLAYROOM_SIGNING_SECRET — REQUIRED by the verification server (server.ts /
# server/googlePlayVerifier.ts). It MUST be one fixed strong value, the same
# on every deploy/restart. If it changes, every previously issued
# entitlement signature becomes invalid and paid passes stop working.
# Generate it once with:  openssl rand -hex 32
# Then paste it here / into the deployment environment. NEVER commit the
# real value to source control.
PLAYROOM_SIGNING_SECRET=<paste-a-strong-random-secret-here>

# Google Play Developer API Service Account (JSON string or base64 for server-side purchase verification)
# Used exclusively server-side by server.ts to verify Google Play purchase tokens with Google's Android Publisher API.
# NEVER expose to client/browser.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# VITE_VERIFY_API_URL — base URL of the OPTIONAL verification server
# (the server in server.ts). Examples:
#   VITE_VERIFY_API_URL=https://verify.playroom.example
# Leave EMPTY to skip server verification entirely: the app then relies on
# the on-device Digital Goods API + the local signed entitlement cache.
# An unreachable/missing endpoint is NEVER faked as success — the client
# falls back to Digital Goods / local cache instead.
VITE_VERIFY_API_URL=

# ---------------------------------------------------------------------------
# AdMob (production IDs — REQUIRED before shipping ads)
# ---------------------------------------------------------------------------
# The code still uses Google's TEST ad unit ID
# (ca-app-pub-3940256099942544/5224354917). Replace with the production
# IDs from the AdMob console before release, or ads will only ever serve
# test ads.
ADMOB_APP_ID=
ADMOB_REWARDED_AD_UNIT_ID=
